<?xml version="1.0"?>
<package format="3">
  <name>plasma_camera_bridge</name>
  <version>0.1.0</version>
  <description>Colors the stable L515 XYZ cloud without modifying the vendor RealSense package.</description>
  <maintainer email="2351787745@qq.com">larusxu</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>realsense2_camera_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>opencv</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>realsense2_camera</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
