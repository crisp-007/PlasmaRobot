  <property name="styleSheet">
   <string notr="true">QWidget {
    background-color: #2b2b2b;
    color: #ffffff;
    font-family: &quot;Microsoft YaHei&quot;;
}

QGroupBox {
    font-weight: bold;
    border: 2px solid #555555;
    border-radius: 8px;
    margin-top: 10px;
    padding-top: 10px;
    background-color: #3a3a3a;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 8px 0 8px;
    color: #ffffff;
}

QComboBox {
    border: 1px solid #555555;
    border-radius: 4px;
    padding: 4px 8px;
    background-color: #4a4a4a;
    color: #ffffff;
    min-height: 20px;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 5px solid #ffffff;
    margin-right: 5px;
}

QComboBox QAbstractItemView {
    border: 1px solid #555555;
    background-color: #4a4a4a;
    selection-background-color: #0078d4;
}

QPushButton {
    background-color: #0078d4;
    border: 1px solid #005a9e;
    border-radius: 6px;
    color: #ffffff;
    font-weight: bold;
    padding: 8px 16px;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #106ebe;
    border: 1px solid #005a9e;
}

QPushButton:pressed {
    background-color: #005a9e;
}

QPushButton:disabled {
    background-color: #555555;
    border: 1px solid #444444;
    color: #888888;
}

QTextEdit {
    border: 1px solid #555555;
    border-radius: 4px;
    background-color: #1e1e1e;
    color: #ffffff;
    font-family: &quot;Consolas&quot;, &quot;Monaco&quot;, monospace;
    font-size: 10pt;
}

QCheckBox {
    color: #ffffff;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #555555;
    border-radius: 3px;
    background-color: #4a4a4a;
}

QCheckBox::indicator:checked {
    background-color: #0078d4;
    border: 1px solid #005a9e;
}

QCheckBox::indicator:checked::after {
    content: &quot;?&quot;;
    color: #ffffff;
    font-weight: bold;
}

QLabel {
    color: #ffffff;
}

QLabel#statusLabel {
    font-weight: bold;
    padding: 4px 8px;
    border-radius: 4px;
    background-color: #4a4a4a;
}

QLabel#statisticsLabel {
    color: #cccccc;
    font-size: 9pt;
}

QTabWidget::pane {
    border: 1px solid #555555;
    background-color: #2b2b2b;
}

QTabBar::tab {
    min-width: 120px;
    min-height: 28px;
    padding: 6px 16px;
    background-color: #3a3a3a;
    border: 1px solid #555555;
}

QTabBar::tab:selected {
    background-color: #0078d4;
    border-color: #005a9e;
}</string>
